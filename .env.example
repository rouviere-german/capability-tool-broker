# Copy to .env for local runs, or generate real keys with `uv run capability-tool-broker keygen`.
# Never commit .env. Each block belongs to one process (compose service); a role never reads
# another role's prefix.

# --- HTTP hygiene for every role ---
APP_SERVICE_NAME=capability-tool-broker
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false
# Comma-separated lowercase SHA-256 digests of API keys (protects /metrics).
APP_API_KEY_SHA256=
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none
APP_DATA_DIR=var

# --- optional live model (tests, demo and bench never need it) ---
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-opus-5
APP_LLM_EFFORT=high
APP_LLM_MAX_RETRIES=2
APP_LLM_TIMEOUT_SECONDS=600
APP_LLM_REFUSAL_FALLBACK=true
APP_BUDGET_MAX_STEPS=50
APP_BUDGET_MAX_TOKENS=200000
APP_BUDGET_MAX_USD=1.0

# --- authority: root keys (kid:base64url, first is active), approver public key, client keys ---
AUTHORITY_ROOT_KEYS=
AUTHORITY_APPROVER_PUBLIC_KEY=
AUTHORITY_CLIENT_PUBLIC_KEYS=
AUTHORITY_POLICY_PATH=
AUTHORITY_AUDIT_PATH=var/authority-audit.jsonl
AUTHORITY_AUDIENCE=authority

# --- broker: the only role holding service credentials ---
BROKER_ROOT_KEYS=
BROKER_MANIFEST_PATH=var/manifest.signed.json
BROKER_MANIFEST_PUBLIC_KEYS=
BROKER_SERVICE_CREDENTIALS=
BROKER_SERVICE_BASE_URL=
BROKER_REDIS_URL=
BROKER_CLIENT_PUBLIC_KEYS=
BROKER_AUDIT_PATH=var/broker-audit.jsonl
BROKER_AUDIENCE=broker

# --- approver: holds only the approval caveat key ---
APPROVER_PRIVATE_KEY=
APPROVER_CLIENT_PUBLIC_KEYS=
APPROVER_STORE_PATH=var/approvals.json
APPROVER_AUDIT_PATH=var/approver-audit.jsonl
APPROVER_DISCHARGE_TTL_SECONDS=120
APPROVER_REVIEWER=human:reviewer
APPROVER_AUDIENCE=approver

# --- fake upstream services ---
SERVICES_CREDENTIALS=
SERVICES_DEMO_DATA=false

# --- redis (compose): its password; compose passes it only to Redis and into BROKER_REDIS_URL ---
REDIS_PASSWORD=

# --- agent host: its own client key and public URLs only ---
AGENT_CLIENT_ID=agent-host
AGENT_CLIENT_PRIVATE_KEY=
AGENT_AUTHORITY_URL=http://authority:8001
AGENT_BROKER_URL=http://broker:8002
AGENT_APPROVER_URL=http://approver:8003
AGENT_MANIFEST_PUBLIC_KEYS=
AGENT_PROVIDER=fake
AGENT_STATE_PATH=var/e2e-state.json
